// One test alert designed to trigger a full kill chain
// (P-001 Phishing -> P-003 Credential Dumping -> P-007 Exfiltration)
CREATE (a:Alert {id: "A-123", severity: "High", name: "Suspicious PowerShell Activity", timestamp: timestamp()})
CREATE (u:User {username: "bob", domain: "CONTOSO", admin: true})
CREATE (h:Host {hostname: "WORKSTATION-01", ip: "192.168.1.100", os: "Windows"})
CREATE (p:Process {process_uid: "WORKSTATION-01:4432:1700000000", pid: 4432, name: "outlook.exe", path: "C:\\Program Files\\Outlook\\", timestamp: timestamp()})
CREATE (c:Process {process_uid: "WORKSTATION-01:4433:1700000001", pid: 4433, name: "powershell.exe", path: "C:\\Windows\\System32\\", timestamp: timestamp()})
CREATE (f:File {path: "C:\\Windows\\System32\\config\\SAM", hash: "abc123", size: 1024})
CREATE (n:Network {dest_ip: "5.6.7.8", dest_port: 443, protocol: "TCP"})
CREATE (a)-[:TRIGGERED_BY]->(p)
CREATE (u)-[:OWNS]->(p)
CREATE (p)-[:RUNS_ON]->(h)
CREATE (p)-[:SPAWNED]->(c)
CREATE (p)-[:READS]->(f)
CREATE (p)-[:CONNECTED_TO]->(n)
